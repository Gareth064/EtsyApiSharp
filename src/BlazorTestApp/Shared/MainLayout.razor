@using BlazorTestApp.Data
@inject RuntimeEtsySettings EtsySettings

@inherits LayoutComponentBase

<PageTitle>Etsy API Workspace</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="workspace">
        <header class="workspace-header">
            <div class="workspace-context">
                <span class="workspace-kicker">Seller workspace</span>
                <span class="workspace-title">API test bench</span>
            </div>
            <div class="workspace-tools">
                <span class="connection-state @(string.IsNullOrWhiteSpace(AppState.TokenResponse) ? "is-idle" : "is-connected")">
                    <span class="status-dot"></span>
                    @(EtsySettings.IsConfigured ? (string.IsNullOrWhiteSpace(AppState.TokenResponse) ? "Ready to connect" : "Connected") : "Set up credentials")
                </span>
                <label class="shop-picker">
                    <span>Active shop</span>
                    <select @onchange="ShopChanged" aria-label="Active shop">
                        <option value="" selected="@(AppState.ShopId == 0)">Choose a shop</option>
                        <option value="17255024" selected="@(AppState.ShopId == 17255024)">Template Runner</option>
                        <option value="10919014" selected="@(AppState.ShopId == 10919014)">Lavender Eight</option>
                    </select>
                </label>
            </div>
        </header>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        EtsySettings.Changed += StateHasChanged;
    }

    private void ShopChanged(ChangeEventArgs e)
    {
        AppState.ShopId = long.TryParse(e.Value?.ToString(), out var shopId) ? shopId : 0;
        StateHasChanged();
    }

    public void Dispose()
    {
        EtsySettings.Changed -= StateHasChanged;
    }
}
