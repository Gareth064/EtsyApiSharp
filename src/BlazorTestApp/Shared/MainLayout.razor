@using BlazorTestApp.Data

@inherits LayoutComponentBase

<PageTitle>BlazorTestApp</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
                <select @onchange=ShopChanged>
                    <option value="" selected="selected">Choose Shop</option>
                    <option value="17255024">Template Runner</option>
                    <option value="10919014">Lavender Eight</option>
                </select>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private void ShopChanged(ChangeEventArgs e)
    {
        var shopId = Convert.ToInt64(e.Value);
        AppState.OnChange += StateHasChanged;
        AppState.ShopId = shopId;
        AppState.OnChange -= StateHasChanged;        
    }
}