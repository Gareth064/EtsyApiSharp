@using BlazorTestApp.Data
@inject RuntimeEtsySettings EtsySettings
@inject ShopWorkspaceState ShopWorkspace
@inject IJSRuntime JSRuntime

@inherits LayoutComponentBase

<PageTitle>Etsy API Workspace</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="workspace">
        <header class="workspace-header">
            <div class="workspace-context">
                <span class="workspace-kicker">Seller workspace</span>
                <span class="workspace-title">API test bench</span>
            </div>
            <div class="workspace-tools">
                <span class="connection-state @(string.IsNullOrWhiteSpace(AppState.TokenResponse) ? "is-idle" : "is-connected")">
                    <span class="status-dot"></span>
                    @(EtsySettings.IsConfigured ? (string.IsNullOrWhiteSpace(AppState.TokenResponse) ? "Ready to connect" : "Connected") : "Set up credentials")
                </span>
                <label class="shop-picker">
                    <span>Active shop</span>
                    <select @onchange="ShopChanged" aria-label="Active shop">
                        <option value="" selected="@(AppState.ShopId == 0)">Choose a shop</option>
                        @foreach (var shop in ShopWorkspace.Shops)
                        {
                            <option value="@shop.Id" selected="@(AppState.ShopId == shop.Id)">@shop.Name</option>
                        }
                    </select>
                </label>
            </div>
        </header>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        EtsySettings.Changed += OnSettingsChanged;
        ShopWorkspace.Changed += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ShopWorkspace.LoadAsync(JSRuntime);
    }

    private void OnSettingsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ShopChanged(ChangeEventArgs e)
    {
        AppState.ShopId = long.TryParse(e.Value?.ToString(), out var shopId) ? shopId : 0;
        StateHasChanged();
    }

    public void Dispose()
    {
        EtsySettings.Changed -= OnSettingsChanged;
        ShopWorkspace.Changed -= OnSettingsChanged;
    }
}
