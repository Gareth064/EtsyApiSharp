@page "/secret/callback/"
@using BlazorTestApp.Data
@using EtsyApiSharp.Services.Auths
@inject IEtsyAuthService AuthService
@inject NavigationManager Navigation

<h3>CallBackUri</h3>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string code { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string state { get; set; }

    protected override async void OnParametersSet()
    {
        Console.WriteLine($"code: {code}");
        Console.WriteLine($"state: {state}");
        AppState.OnChange += StateHasChanged;
        AppState.AuthorizationCode = code;
        AppState.OnChange -= StateHasChanged;
        await GetAccessToken();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task GetAccessToken()
    {
        var token = await AuthService.GetFirstAccessTokenAsync(AppState.AuthorizationCode, AppState.CodeVerifier);
        AppState.OnChange += StateHasChanged;
        AppState.TokenResponse = token.AccessToken;
        AppState.OnChange -= StateHasChanged;
    }
}
