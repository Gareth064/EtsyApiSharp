@page "/"
@using BlazorTestApp.Data
@using EtsyApiSharp.Models
@using EtsyApiSharp.Models.Filters
@using EtsyApiSharp.Services.ReceiptManagements
@using EtsyApiSharp.Services.Auths
@using System.Text.Json
@inject NavigationManager Navigation
@inject IEtsyAuthService AuthService
@inject IEtsyReceiptManagementService ReceiptService


<h1>Etsy OAuth2 Test</h1>

<button @onclick="Authorise">Get Authorization Code</button>
<br />
<label>Authorization Code: </label><label>@AppState.AuthorizationCode</label>
<br />
<br />
<br />
<button @onclick="GetAccessToken">Get Access Token</button>
<br />
<label>Access Token: </label><label>@AppState.TokenResponse</label>
<br />
<br />
<br />
<input @bind="recieptId" />
<button @onclick="GetReciept">Get Reciept</button>
<button @onclick="GetRecieptTransactionsByRecieptId">Get Transactions by Reciept Id</button>
<br />
<br />
<br />
<button @onclick="GetReciepts">Get Reciepts</button>
<br />
<br />
<br />
<input @bind="listingId" />
<button @onclick="GetRecieptTransactionsByListingId">Get Transactions by Listing Id</button>
<br />
<br />
<br />
<input @bind="transactionId" />
<button @onclick="GetTransaction">Get Transaction by Id</button>
<br />
<br />
<br />
<button @onclick="GetTransactionsByShop">Get Transactions by Shop</button>
<br />
<br />
<br />

@resultToDisplay

@code {
    List<Scope> scopes = new List<Scope> { Scope.shops_r, Scope.shops_w, Scope.cart_r, Scope.listings_w, Scope.listings_r, Scope.email_r, Scope.transactions_r };
    string recieptId = "2256218026";
    string listingId = "867662080";
    string transactionId = "2721211423";
    string resultToDisplay = string.Empty;    

    private void Authorise()
    {
        Console.WriteLine("starting");
        AppState.CodeVerifier = "test";
        var authUri = AuthService.BuildAuthorizationUrl(AppState.CodeVerifier);
        Console.WriteLine(authUri);
        Navigation.NavigateTo(authUri);
    }

    private async Task GetAccessToken()
    {
        var token = await AuthService.GetFirstAccessTokenAsync(AppState.AuthorizationCode, AppState.CodeVerifier);
        AppState.OnChange += StateHasChanged;
        AppState.TokenResponse = token.AccessToken;
        AppState.OnChange -= StateHasChanged;
    }

    private async Task GetReciept()
    {
        var result = await ReceiptService.GetShopReceiptAsync(AppState.TokenResponse,
            Convert.ToInt64("17255024"), Convert.ToInt64(recieptId));

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }

    private async Task GetReciepts()
    {
        var paramss = new GetShopReceiptsFilter();

        //paramss.MinLastModified=1637161723;
        paramss.WasPaid = true;

        var result = await ReceiptService.GetShopReceiptsAsync(AppState.TokenResponse,
            Convert.ToInt64("17255024"), paramss);

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }

    private async Task GetRecieptTransactionsByListingId()
    {
        var result = await ReceiptService.GetShopReceiptTransactionsByListingAsync(
            apiToken: AppState.TokenResponse,
            shopId: Convert.ToInt64("17255024"),
            listingId: Convert.ToInt64(listingId));

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }
    
    private async Task GetRecieptTransactionsByRecieptId()
    {
        var result = await ReceiptService.GetShopReceiptTransactionsByReceiptAsync(
            apiToken: AppState.TokenResponse,
            shopId: Convert.ToInt64("17255024"),
            receiptid: Convert.ToInt64(recieptId));

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }

        private async Task GetTransaction()
    {
        var result = await ReceiptService.GetShopReceiptTransactionAsync(apiToken: AppState.TokenResponse,
            shopId: Convert.ToInt64("17255024"), transactionId: Convert.ToInt64(transactionId));

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }

    private async Task GetTransactionsByShop()
    {
        var paramss = new GetShopReceiptTransactionsByShopFilter();

        var result = await ReceiptService.GetShopReceiptTransactionsByShopAsync(AppState.TokenResponse,
            Convert.ToInt64("17255024"), paramss);

        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }
}