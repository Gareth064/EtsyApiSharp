@page "/"
@using BlazorTestApp.Components
@using BlazorTestApp.Data
@using EtsyApiSharp.Helpers
@using EtsyApiSharp.Services.Auths
@inject NavigationManager Navigation
@inject IEtsyAuthService AuthService

<section class="welcome-banner">
    <div>
        <p class="eyebrow">Welcome back</p>
        <h1>Keep your shop moving.</h1>
        <p>Connect an Etsy account, select a shop, and test the API surfaces that support your seller workflow.</p>
    </div>
    <div class="welcome-illustration" aria-hidden="true"><span>✦</span><span>✳</span><span>●</span></div>
</section>

<ServiceTemplate ServiceTitle="Connect your account" ShowResultsPane="false" ResultsToDisplay="">
    <button @onclick="Authorise">Connect with Etsy</button>
    <div class="credential-value">
        <span>Authorization code</span>
        <code>@(string.IsNullOrWhiteSpace(AppState.AuthorizationCode) ? "Waiting for authorization" : "Authorization received")</code>
    </div>
    <button @onclick="GetAccessToken">Get access token</button>
    <div class="credential-value">
        <span>Access token</span>
        <code>@(string.IsNullOrWhiteSpace(AppState.TokenResponse) ? "Not connected" : "Connected")</code>
    </div>
</ServiceTemplate>

@code {
    private void Authorise()
    {
        AppState.CodeVerifier = AuthHelper.CreateCodeVerifier();
        AppState.OAuthState = AuthHelper.CreateState();
        Navigation.NavigateTo(AuthService.BuildAuthorizationUrl(AppState.CodeVerifier, AppState.OAuthState));
    }

    private async Task GetAccessToken()
    {
        var token = await AuthService.GetFirstAccessTokenAsync(AppState.AuthorizationCode, AppState.CodeVerifier);
        AppState.TokenResponse = token.AccessToken;
        await InvokeAsync(StateHasChanged);
    }
}
