@page "/"
@using BlazorTestApp.Components
@using BlazorTestApp.Data
@using EtsyApiSharp.Models
@using EtsyApiSharp.Services.Auths
@inject NavigationManager Navigation
@inject IEtsyAuthService AuthService

<ServiceTemplate ServiceTitle="Auth Services" ShowResultsPane="false" ResultsToDisplay="">
<button @onclick="Authorise">Get Authorization Code</button>
<br />
<label>Authorization Code: </label><label>@AppState.AuthorizationCode</label>
<br />
<br />
<br />
<button @onclick="GetAccessToken">Get Access Token</button>
<br />
<label>Access Token: </label><label>@AppState.TokenResponse</label>
</ServiceTemplate>


@code {
    List<Scope> scopes = new List<Scope> { Scope.shops_r, Scope.shops_w, Scope.cart_r, Scope.listings_w, Scope.listings_r, Scope.email_r, Scope.transactions_r };

    private void Authorise()
    {
        Console.WriteLine("starting");
        AppState.CodeVerifier = "test";
        var authUri = AuthService.BuildAuthorizationUrl(AppState.CodeVerifier);
        Console.WriteLine(authUri);
        Navigation.NavigateTo(authUri);
    }

    private async Task GetAccessToken()
    {
        var token = await AuthService.GetFirstAccessTokenAsync(AppState.AuthorizationCode, AppState.CodeVerifier);
        AppState.OnChange += StateHasChanged;
        AppState.TokenResponse = token.AccessToken;
        AppState.OnChange -= StateHasChanged;
    }

}