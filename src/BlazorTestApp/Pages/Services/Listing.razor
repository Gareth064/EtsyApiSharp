@page "/services/listing"
@using BlazorTestApp.Components
@using BlazorTestApp.Data
@using EtsyApiSharp.Models.Filters
@using EtsyApiSharp.Models.Listings.Enums
@using System.Text.Json
@using EtsyApiSharp.Services.ListingManagements
@inject IEtsyListingManagementService ListingService

<ServiceTemplate ServiceTitle="Listing Services" ShowResultsPane="true" ResultsToDisplay=@resultToDisplay>
    <input @bind="listingId" />
    <button @onclick="GetListingAsync">Listing by Listing ID</button>
    <button @onclick="GetListingImagesAsync">Listing Images by Listing ID</button>
    <button @onclick="GetListingPropertiesAsync">Listing Properties by Listing ID</button>
    <br />
    <br />
        <input @bind="listingImageId" />
    <button @onclick="GetListingImageAsync">Listing Image By Image ID By Listing ID</button>
    <br />
    <br />
    <input @bind="propertyId" />
    <button @onclick="GetListingPropertyAsync">Listing Property By Property ID</button>
    <br />
    <br />
    <input @bind="shopId" />
    <button @onclick="GetFeaturedListingsByShopAsync">Featured Listings By Shop ID</button>
    <button @onclick="FindAllActiveListingsByShopAsync">Active Listings By Shop ID</button>
    <button @onclick="GetListingsByShopAsync">Listings By Shop ID</button>
    <br />
    <input @bind="sectionIds" />(Comma seperated)
    <button @onclick="GetListingsByShopSectionIdAsync">Listings By Section IDs</button>
    <br />
    <br />
    <button @onclick="FindAllListingsActiveAsync">All Active Listings</button>
    <br />
    <br />
    <input @bind="receiptId" />
    <button @onclick="GetListingsByShopReceiptAsync">Get Listings by Receipt ID</button>
    <br />
    <br />
    <button @onclick="GetListingsByListingIdsAsync">Get Listings By Listing IDs</button>
</ServiceTemplate>

@code {
    string resultToDisplay = string.Empty;
    string listingId = "";
    string listingImageId = "";
    string receiptId = "";
    string propertyId = "";
    string shopId;
    string sectionIds;

    private async Task GetListingAsync()
    {
        var includes = new List<ListingInclude>();
        includes.Add(ListingInclude.Images);
        includes.Add(ListingInclude.Shipping);
        includes.Add(ListingInclude.Shop);
        includes.Add(ListingInclude.User);

        var result = await ListingService.GetListingAsync(
            AppState.TokenResponse,
            Convert.ToInt64(listingId),
            includes
        );

        DisplayResultsOnScreen(result);
    }

    private async Task GetFeaturedListingsByShopAsync()
    {
        var filter = new GetFeaturedListingsByShopFilter();
        filter.Limit = 1;

        if (String.IsNullOrEmpty(shopId))
        {
            shopId = AppState.ShopId.ToString();
        }

        var result = await ListingService.GetFeaturedListingsByShopAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            filter);

        DisplayResultsOnScreen(result);
    }

    private async Task FindAllListingsActiveAsync()
    {
        var filter = new FindAllListingsActiveFilter();

        var result = await ListingService.FindAllListingsActiveAsync(
            AppState.TokenResponse,
            filter);

        DisplayResultsOnScreen(result);
    }

    private async Task FindAllActiveListingsByShopAsync()
    {
        var filter = new FindAllActiveListingsByShopFilter();

        if (String.IsNullOrEmpty(shopId))
            shopId = AppState.ShopId.ToString();

        var result = await ListingService.FindAllActiveListingsByShopAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            filter);

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingsByShopAsync()
    {
        var filter = new GetListingsByShopFilter();
        filter.SortOn = ListingSortOn.price;
        filter.SortOrder = ListingSortOrder.desc;

        if (String.IsNullOrEmpty(shopId))
            shopId = AppState.ShopId.ToString();

        var result = await ListingService.GetListingsByShopAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            filter);

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingsByShopReceiptAsync()
    {
        var filter = new GetListingsByShopReceiptFilter();
        filter.Limit = 1;

        if (String.IsNullOrEmpty(shopId))
        {
            shopId = AppState.ShopId.ToString();
        }

        var result = await ListingService.GetListingsByShopReceiptAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            Convert.ToInt64(receiptId),
            filter);

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingPropertiesAsync()
    {
        if (String.IsNullOrEmpty(shopId))
            shopId = AppState.ShopId.ToString();

        var result = await ListingService.GetListingPropertiesAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            Convert.ToInt64(listingId));

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingPropertyAsync()
    {
        var result = await ListingService.GetListingPropertyAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            Convert.ToInt64(propertyId));

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingsByListingIdsAsync()
    {
        var IdList = new List<long>();
        IdList.Add(499552854);
        IdList.Add(803745479);
        IdList.Add(1141926638);

        var includes = new List<ListingInclude>();
        includes.Add(ListingInclude.Images);
        includes.Add(ListingInclude.Shipping);
        includes.Add(ListingInclude.Shop);
        includes.Add(ListingInclude.User);

        var result = await ListingService.GetListingsByListingIdsAsync(
            AppState.TokenResponse,
            IdList,
            includes
        );

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingsByShopSectionIdAsync()
    {
        var IdList = new List<long>();
        var ids = sectionIds.Split(',');

        foreach(var id in ids)
        {
            IdList.Add(Int64.Parse(id));
        }

        var result = await ListingService.GetListingsByShopSectionIdAsync(
            AppState.TokenResponse,
            Convert.ToInt64(shopId),
            IdList,
            null);

        DisplayResultsOnScreen(result);
    }

    private async Task GetListingImageAsync()
    {
        var result = await ListingService.GetListingImageAsync(
            AppState.TokenResponse,
            Convert.ToInt64(listingId),
            Convert.ToInt64(listingImageId)
        );

        DisplayResultsOnScreen(result);
    }

        private async Task GetListingImagesAsync()
    {
        var result = await ListingService.GetListingImagesAsync(
            AppState.TokenResponse,
            Convert.ToInt64(listingId));

        DisplayResultsOnScreen(result);
    }

    private void DisplayResultsOnScreen<T>(T result)
    {
        var tempString = JsonSerializer.Serialize(result);
        var jDoc = JsonDocument.Parse(tempString);

        resultToDisplay = JsonSerializer.Serialize(jDoc,
            new JsonSerializerOptions { WriteIndented = true });

        Console.WriteLine(resultToDisplay);
    }
}
