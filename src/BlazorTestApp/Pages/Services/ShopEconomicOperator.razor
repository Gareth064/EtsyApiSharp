@page "/services/shop-economic-operators"
@using BlazorTestApp.Components
@using BlazorTestApp.Data
@using EtsyApiSharp.Services.ShopEconomicOperatorManagements
@using System.Text.Json
@inject IEtsyShopEconomicOperatorManagementService EconomicOperatorService

<ServiceTemplate ServiceTitle="Shop Economic Operator Services" ShowResultsPane="true" ResultsToDisplay="@resultToDisplay">
    <input @bind="shopId" placeholder="Shop ID (defaults to authorised shop)" />
    <button @onclick="GetEconomicOperatorsAsync">Economic operators (OAuth)</button>
    <br />
    <input @bind="economicOperatorId" placeholder="Economic operator ID" />
    <button @onclick="GetEconomicOperatorAsync">Get economic operator (OAuth)</button>
    <p>Creation and updates are available through the service contract and require deliberate request payloads; this harness exposes non-destructive retrieval operations only.</p>
</ServiceTemplate>

@code {
    private string resultToDisplay = string.Empty;
    private string shopId = string.Empty;
    private string economicOperatorId = string.Empty;

    private async Task GetEconomicOperatorsAsync() => await DisplayAsync(EconomicOperatorService.GetShopEconomicOperatorsAsync(AppState.TokenResponse, GetShopId()));

    private async Task GetEconomicOperatorAsync() => await DisplayAsync(EconomicOperatorService.GetShopEconomicOperatorAsync(
        AppState.TokenResponse, GetShopId(), GetRequiredId(economicOperatorId, "economic operator ID")));

    private long GetShopId() => string.IsNullOrWhiteSpace(shopId) ? AppState.ShopId : GetRequiredId(shopId, "shop ID");

    private static long GetRequiredId(string value, string name) => long.TryParse(value, out var id) && id > 0
        ? id
        : throw new InvalidOperationException($"A positive {name} is required.");

    private async Task DisplayAsync<T>(Task<T> operation)
    {
        try
        {
            DisplayResultsOnScreen(await operation);
        }
        catch (Exception exception)
        {
            resultToDisplay = exception.Message;
        }
    }

    private void DisplayResultsOnScreen<T>(T result)
    {
        var json = JsonSerializer.Serialize(result);
        using var document = JsonDocument.Parse(json);
        resultToDisplay = JsonSerializer.Serialize(document, new JsonSerializerOptions { WriteIndented = true });
    }
}
