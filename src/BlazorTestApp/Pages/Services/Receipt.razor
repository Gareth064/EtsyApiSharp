@page "/services/receipt"
@using BlazorTestApp.Components
@using BlazorTestApp.Data
@using EtsyApiSharp.Models.Filters
@using EtsyApiSharp.Services.ReceiptManagements
@using System.Text.Json
@inject IEtsyReceiptManagementService ReceiptService

<ServiceTemplate ServiceTitle="Receipt Services" ShowResultsPane="true" ResultsToDisplay="@resultToDisplay">
    <input @bind="shopId" placeholder="Shop ID (defaults to authorised shop)" />
    <button @onclick="GetReceiptsAsync">Shop receipts (OAuth)</button>
    <button @onclick="GetTransactionsByShopAsync">Shop transactions (OAuth)</button>
    <br />
    <input @bind="receiptId" placeholder="Receipt ID" />
    <button @onclick="GetReceiptAsync">Get receipt (OAuth)</button>
    <button @onclick="GetTransactionsByReceiptAsync">Receipt transactions (OAuth)</button>
    <br />
    <input @bind="listingId" placeholder="Listing ID" />
    <button @onclick="GetTransactionsByListingAsync">Listing transactions (OAuth)</button>
    <br />
    <input @bind="transactionId" placeholder="Transaction ID" />
    <button @onclick="GetTransactionAsync">Get transaction (OAuth)</button>
    <p>All eight Receipt Management operations are available through the typed service. This harness intentionally exposes only the six non-destructive retrieval operations; receipt updates and shipment creation require deliberate request payloads in application code.</p>
</ServiceTemplate>

@code {
    private string resultToDisplay = string.Empty;
    private string shopId = string.Empty;
    private string receiptId = string.Empty;
    private string listingId = string.Empty;
    private string transactionId = string.Empty;

    private async Task GetReceiptAsync() => await DisplayAsync(ReceiptService.GetShopReceiptAsync(
        AppState.TokenResponse, GetShopId(), GetRequiredId(receiptId, "receipt ID")));

    private async Task GetReceiptsAsync() => await DisplayAsync(ReceiptService.GetShopReceiptsAsync(
        AppState.TokenResponse, GetShopId(), new GetShopReceiptsFilter { Limit = 10 }));

    private async Task GetTransactionsByListingAsync() => await DisplayAsync(ReceiptService.GetShopReceiptTransactionsByListingAsync(
        AppState.TokenResponse,
        GetShopId(),
        GetRequiredId(listingId, "listing ID"),
        new GetShopReceiptTransactionsByListingFilter { Limit = 10 }));

    private async Task GetTransactionsByReceiptAsync() => await DisplayAsync(ReceiptService.GetShopReceiptTransactionsByReceiptAsync(
        AppState.TokenResponse, GetShopId(), GetRequiredId(receiptId, "receipt ID")));

    private async Task GetTransactionAsync() => await DisplayAsync(ReceiptService.GetShopReceiptTransactionAsync(
        AppState.TokenResponse, GetShopId(), GetRequiredId(transactionId, "transaction ID")));

    private async Task GetTransactionsByShopAsync() => await DisplayAsync(ReceiptService.GetShopReceiptTransactionsByShopAsync(
        AppState.TokenResponse, GetShopId(), new GetShopReceiptTransactionsByShopFilter { Limit = 10 }));

    private long GetShopId() => string.IsNullOrWhiteSpace(shopId)
        ? AppState.ShopId
        : GetRequiredId(shopId, "shop ID");

    private static long GetRequiredId(string value, string name) => long.TryParse(value, out var id) && id > 0
        ? id
        : throw new InvalidOperationException($"A positive {name} is required.");

    private async Task DisplayAsync<T>(Task<T> operation)
    {
        try
        {
            DisplayResultsOnScreen(await operation);
        }
        catch (Exception exception)
        {
            resultToDisplay = exception.Message;
        }
    }

    private void DisplayResultsOnScreen<T>(T result)
    {
        var json = JsonSerializer.Serialize(result);
        using var document = JsonDocument.Parse(json);
        resultToDisplay = JsonSerializer.Serialize(document, new JsonSerializerOptions { WriteIndented = true });
    }
}
